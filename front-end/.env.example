# Optional. API origin the browser calls. A trailing slash is optional;
# the client adds one so ky can resolve relative paths against this base.
# When unset, the client falls back to the page origin (Vite proxy) and warns.
# Docker / launchSettings HTTP:
VITE_API_BASE_URL=http://localhost:5127
#
# Host-run HTTPS:
# VITE_API_BASE_URL=https://localhost:7067
#
# Production:
# VITE_API_BASE_URL=https://api.example.org

# Optional: where Vite forwards /api and /auth (vite.config.ts only).
# Used only if VITE_API_BASE_URL points at the Vite origin.
# Docker / launchSettings HTTP (default):
# API_PROXY_TARGET=http://localhost:5127
#
# Host-run HTTPS:
# API_PROXY_TARGET=https://localhost:7067
