# Browser calls stay same-origin. Vite proxies /api and /auth to the API.
# Do not set VITE_API_BASE_URL to http://localhost:5127 — that bypasses the
# proxy and requires CORS on the API.

# Optional: override the proxy target (read by vite.config.ts, not the browser).
# Docker / launchSettings HTTP (default):
# API_PROXY_TARGET=http://localhost:5127
#
# Host-run HTTPS:
# API_PROXY_TARGET=https://localhost:7067
