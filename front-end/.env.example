# Local default: leave VITE_API_BASE_URL unset so the browser stays
# same-origin. Vite then proxies /api and /auth to the API.

# Optional: browser API origin (bypasses the Vite proxy). Needed when the
# SPA and the API are not on the same host — the API must allow CORS then.
# VITE_API_BASE_URL=https://api.example.org

# Optional: where Vite forwards /api and /auth (vite.config.ts only).
# Docker / launchSettings HTTP (default):
# API_PROXY_TARGET=http://localhost:5127
#
# Host-run HTTPS:
# API_PROXY_TARGET=https://localhost:7067
