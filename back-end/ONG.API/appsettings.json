{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "ong-api",
    "ExpiryMinutes": 60
  },
  "ClientCredentials": {
    "ExpiryMinutes": 15
  },
  "PasswordHasher": {
    "IterationCount": 100000,
    "CompatibilityMode": "IdentityV3"
  }
}
