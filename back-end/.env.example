# Copy this file to `.env` (same directory as docker-compose.yml) and fill in real
# values before running `docker compose up`. `.env` is git-ignored — never commit it.
#
# In CI, these are supplied as GitHub Actions secrets (see .github/workflows/backend-docker.yml).
# In production (Render), set the equivalent env vars directly in the Render dashboard —
# Render builds from ONG.API/Dockerfile and never reads this file or docker-compose.yml.

# --- PostgreSQL container credentials -----------------------------------------------
# Local/CI only: this is the throwaway database docker-compose spins up. Render uses its
# own managed Postgres instance with its own credentials, configured separately.
POSTGRES_USER=ong_user
POSTGRES_PASSWORD=replace-with-a-strong-local-password
POSTGRES_DB=ongdb

# --- Seeded admin identity -----------------------------------------------------------
# back-end/ONG.Infrastructure/DataBase/AdminSeeder.cs. The only account that can log in
# via POST /auth/login. Changing ADMIN_SEED_PASSWORD and restarting the app rotates the
# admin's password (AdminSeeder reconciles the seeded row to match on every startup).
ADMIN_SEED_USERNAME=admin
ADMIN_SEED_PASSWORD=replace-with-a-strong-password

# --- JWT signing key -------------------------------------------------------------------
# back-end/ONG.Infrastructure/Security/JwtTokenGenerator.cs. Must be at least 32 characters
# (validated fail-fast at startup). Generate one with:
#   openssl rand -base64 32
JWT_KEY=replace-with-a-random-32-character-or-longer-string

# --- OAuth client credentials ---------------------------------------------------------
# back-end/ONG.Infrastructure/Security/ClientCredentialsProvider.cs. The single configured
# client (front-web) able to exchange these for a short-lived token via
# POST /oauth/token. CLIENT_SECRET must be at least 16 characters (validated fail-fast at
# startup). Generate one with:
#   openssl rand -base64 24
CLIENT_ID=front-web
CLIENT_SECRET=replace-with-a-random-16-character-or-longer-string
